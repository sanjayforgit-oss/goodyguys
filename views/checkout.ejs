<%- include('partials/header') %>

<section class="page-header">
  <div class="container">
    <span class="section-label">Checkout</span>
    <h1>Shipping &amp; Order Details</h1>
    <p>Provide your delivery address and contact information to confirm your custom order</p>
  </div>
</section>

<section class="checkout-page" style="padding-top: 40px;">
  <div class="container">
    <div class="checkout-layout">
      <!-- Checkout Form -->
      <form class="checkout-form" id="checkoutOrderForm" method="POST" action="/checkout" enctype="multipart/form-data">
        <% if (typeof error !== 'undefined' && error) { %>
          <div class="alert-box error" style="margin-bottom: 24px; padding: 14px 18px; border-radius: 8px;">
            ⚠️ <%= error %>
          </div>
        <% } %>

        <!-- 1. Customer Information -->
        <div class="checkout-section">
          <h2>1. Contact Information</h2>
          <div class="form-group">
            <label for="name">Full Name <span class="req-star">*</span></label>
            <input type="text" id="name" name="name" class="form-input" required placeholder="e.g. Rahul Sharma">
          </div>
          <div class="form-row-2">
            <div class="form-group">
              <label for="email">Email Address <span class="req-star">*</span></label>
              <input type="email" id="email" name="email" class="form-input" required placeholder="rahul@example.com">
            </div>
            <div class="form-group">
              <label for="phone">WhatsApp / Phone Number <span class="req-star">*</span></label>
              <input type="tel" id="phone" name="phone" class="form-input" required placeholder="+91 90369 69700">
              <span class="field-hint">We will send design preview &amp; tracking updates on WhatsApp</span>
            </div>
          </div>
        </div>

        <!-- 2. Shipping Address -->
        <div class="checkout-section">
          <h2>2. Delivery Address</h2>

          <!-- Campus Exclusive Service Notice -->
          <div class="campus-delivery-banner">
            <span class="campus-banner-icon">📍</span>
            <div class="campus-banner-text">
              <strong>Exclusive Campus Service Zone: Sathyabama College, Chennai</strong>
              <p>We currently operate and deliver <strong>exclusively inside Sathyabama Institute of Science and Technology Campus (Jeppiaar Nagar, Rajiv Gandhi Salai OMR, Chennai - 600119)</strong>. Please provide your hostel, department, lab, or staff quarters address.</p>
            </div>
          </div>

          <div class="form-group">
            <label for="address">Campus Block, Hostel Name &amp; Room No. / Dept <span class="req-star">*</span></label>
            <textarea id="address" name="address" class="form-input" rows="2" required placeholder="e.g. Room 214, Mother Teresa Hostel (or Mech Dept / Block 5 / Staff Quarters), Sathyabama Campus, OMR, Chennai" oninput="validateDeliveryLocation()"></textarea>
          </div>
          <div class="form-row-2">
            <div class="form-group">
              <label for="city">City / Location <span class="req-star">*</span></label>
              <input type="text" id="city" name="city" class="form-input" required value="Chennai" placeholder="Chennai" oninput="validateDeliveryLocation()">
            </div>
            <div class="form-group">
              <label for="pincode">Pincode <span class="req-star">*</span></label>
              <input type="text" id="pincode" name="pincode" class="form-input" required value="600119" placeholder="600119" pattern="[0-9]{6}" maxlength="6" oninput="validateDeliveryLocation()">
              <span class="field-hint">Campus Postal Pincode: <strong>600119</strong> (Jeppiaar Nagar, OMR)</span>
            </div>
          </div>

          <!-- Dynamic Delivery Availability Banner -->
          <div id="deliveryStatusBanner" class="delivery-status-banner eligible">
            ✓ <strong>Delivery Available</strong>: Sathyabama College Campus, Chennai (Pincode: 600119).
          </div>

          <div class="form-group" style="margin-top: 14px;">
            <label for="specialNotes">Special Workshop / Delivery Instructions (Optional)</label>
            <input type="text" id="specialNotes" name="specialNotes" class="form-input" placeholder="e.g. Call before delivery, or leave at hostel reception">
          </div>
        </div>

        <!-- 3. Campus Coupon & Offers -->
        <div class="checkout-section">
          <h2>3. Campus Offer &amp; Coupon</h2>

          <div class="campus-coupon-card">
            <!-- Message area for customer -->
            <div class="coupon-message-box">
              <div class="coupon-message-title">
                <span class="coupon-badge-pill">CAMPUS SPECIAL</span>
                <span>Free Delivery Inside Sathyabama College</span>
              </div>
              <div class="coupon-message-body">
                Delivery inside <strong>Sathyabama Institute of Science and Technology campus, Chennai</strong> is completely <strong>FREE</strong>! Use coupon code <span class="coupon-code-click" onclick="fillCoupon('SATHYABAMA')">SATHYABAMA</span> below to remove your delivery charges.
              </div>
            </div>

            <!-- Coupon Input Box -->
            <label for="couponInput" style="display:block; font-size: 0.85rem; font-weight: 700; color: #ffffff; margin-bottom: 8px;">Have a Promo / Campus Coupon Code?</label>
            <div class="coupon-input-wrapper">
              <input type="text" id="couponInput" placeholder="ENTER COUPON CODE" maxlength="20" autocomplete="off">
              <button type="button" class="btn-apply-coupon" id="btnApplyCoupon" onclick="applyCouponCode()">Apply Coupon</button>
            </div>
            <div id="couponFeedback"></div>
            <input type="hidden" name="couponCode" id="hiddenCouponCode" value="">
          </div>
        </div>

        <!-- 4. Payment Method -->
        <div class="checkout-section">
          <h2>4. Select Payment Method</h2>
          <div class="payment-options">
            <label class="payment-option active" id="payOptionUpi">
              <input type="radio" name="paymentMethod" value="UPI (GPay / PhonePe)" checked onchange="togglePaymentMode('UPI')">
              <div class="payment-option-content">
                <strong>📱 Google Pay / PhonePe / Paytm / UPI QR (0% Fee)</strong>
                <p>Scan QR code or pay to UPI ID, then enter your 12-digit Transaction ID</p>
              </div>
            </label>
            <label class="payment-option" id="payOptionCod">
              <input type="radio" name="paymentMethod" value="COD" onchange="togglePaymentMode('COD')">
              <div class="payment-option-content">
                <strong>💵 Cash on Delivery (COD)</strong>
                <p>Pay cash upon doorstep delivery</p>
              </div>
            </label>
          </div>

          <!-- Dynamic UPI & GPay Payment Box -->
          <% 
            let calcSub = 0;
            cartItems.forEach(item => { calcSub += item.unitPrice * item.quantity; });
            let shipFee = calcSub >= 499 ? 0 : 49;
            let finalPayAmount = calcSub + shipFee;
            let storeUpiId = typeof upiId !== 'undefined' && upiId ? upiId : "9036969700@upi";
            let storeUpiNumber = "9036969700";
          %>
          <div class="upi-payment-container" id="upiPaymentBox">
            <div class="upi-header">
              <span class="upi-step-tag">Step-by-Step Payment</span>
              <h3>Scan &amp; Pay via GPay / PhonePe / Paytm</h3>
              <p>Pay <strong id="upiPayAmountTxt">₹<%= finalPayAmount.toLocaleString() %></strong> directly to our workshop account with 0% gateway charges.</p>
            </div>

            <div class="upi-grid-details">
              <!-- QR Code Card -->
              <div class="upi-qr-card">
                <img id="dynamicUpiQr" src="https://api.qrserver.com/v1/create-qr-code/?size=220x220&data=<%= encodeURIComponent('upi://pay?pa=' + storeUpiId + '&pn=GOODYGUYS+Studio&am=' + finalPayAmount + '&cu=INR&tn=GOODYGUYSOrder') %>" alt="UPI Payment QR Code" class="upi-qr-img">
                <span class="qr-label">Scan with any UPI App</span>
                <div class="upi-apps-icons">
                  <span>GPay</span> • <span>PhonePe</span> • <span>Paytm</span> • <span>BHIM</span>
                </div>
              </div>

              <!-- UPI Info & Steps -->
              <div class="upi-instructions-card">
                <div class="upi-id-row">
                  <span class="id-label">Store UPI Number:</span>
                  <div class="upi-id-copy-box">
                    <code id="merchantUpiId"><%= storeUpiNumber %></code>
                    <button type="button" class="btn btn-sm btn-outline" onclick="copyUpiId()">📋 Copy</button>
                  </div>
                  <span id="copySuccessMsg" style="display:none; color: #22c55e; font-size: 0.75rem;">✓ Copied!</span>
                </div>
                <div style="font-size: 0.8rem; color: #94a3b8; margin-top: -6px; margin-bottom: 12px;">
                  UPI ID: <strong style="color: #ffffff;"><%= storeUpiId %></strong>
                </div>

                <div class="upi-steps-list">
                  <div class="upi-step-item">
                    <span class="num">1</span>
                    <p>Open <strong>Google Pay</strong>, <strong>PhonePe</strong>, or <strong>Paytm</strong> on your phone.</p>
                  </div>
                  <div class="upi-step-item">
                    <span class="num">2</span>
                    <p>Scan the QR code or transfer <strong id="upiStepAmountTxt">₹<%= finalPayAmount.toLocaleString() %></strong> to UPI Number <code><%= storeUpiNumber %></code> (or UPI ID <code><%= storeUpiId %></code>).</p>
                  </div>
                  <div class="upi-step-item">
                    <span class="num">3</span>
                    <p>After paying, copy the <strong>12-digit UPI Reference / UTR Number</strong> from your payment receipt and paste below.</p>
                  </div>
                </div>

                <!-- 12-digit UTR Input Field -->
                <div class="form-group utr-group">
                  <label for="upiTransactionId">Enter 12-Digit UPI Transaction / UTR ID <span class="req-star">*</span></label>
                  <input type="text" id="upiTransactionId" name="upiTransactionId" class="form-input form-input-lg" placeholder="e.g. 4289xxxxxxxx (12 digits)" maxlength="16">
                  <span class="field-hint">💡 Found in your payment details as "UPI Ref No" or "UTR"</span>
                </div>

                <!-- Optional Payment Screenshot -->
                <div class="form-group" style="margin-top: 10px;">
                  <label for="paymentScreenshot" style="font-size: 0.82rem; color: var(--text-muted);">Optional: Attach Payment Screenshot</label>
                  <input type="file" id="paymentScreenshot" name="paymentProof" accept="image/*" class="form-input form-input-sm">
                </div>
              </div>
            </div>
          </div>
        </div>

        <button type="submit" class="btn btn-primary btn-lg btn-block" id="btnPlaceOrder">🔒 Confirm &amp; Submit Order</button>
      </form>

      <!-- Order Summary Card -->
      <div class="checkout-summary">
        <h3>Order Items Summary</h3>
        <% let runningSubtotal = 0 %>
        <% cartItems.forEach(item => { %>
          <% const itemLinePrice = item.unitPrice * item.quantity %>
          <% runningSubtotal += itemLinePrice %>
          <div class="checkout-item">
            <img src="<%= item.product.image %>" alt="<%= item.product.name %>">
            <div class="checkout-item-details">
              <p class="checkout-item-name"><%= item.product.name %></p>
              <% if (item.customText) { %><p class="checkout-item-sub">✍️ <%= item.customText %></p><% } %>
              <% if (item.size) { %><p class="checkout-item-sub">📐 Size: <%= item.size %></p><% } %>
              <% if (item.placement) { %><p class="checkout-item-sub">Placement: <%= item.placement %></p><% } %>
              <% if (item.mugSides) { %><p class="checkout-item-sub">Sides: <%= item.mugSides %></p><% } %>
              <p class="checkout-item-qty">Qty: <%= item.quantity %> × ₹<%= item.unitPrice %></p>
            </div>
            <span class="checkout-item-price">₹<%= itemLinePrice.toLocaleString() %></span>
          </div>
        <% }) %>

        <div class="summary-divider"></div>
        <div class="summary-row">
          <span>Subtotal</span>
          <span>₹<%= runningSubtotal.toLocaleString() %></span>
        </div>
        <div class="summary-row">
          <span>Delivery Charge</span>
          <span id="summaryDeliveryFee"><%= runningSubtotal >= 499 ? 'FREE' : '₹49' %></span>
        </div>
        <div class="summary-row" id="summaryCouponRow" style="display: none; color: #4ade80;">
          <span>Campus Coupon (<span id="summaryCouponName"></span>)</span>
          <span id="summaryDiscount">-₹49</span>
        </div>
        <div class="summary-row summary-total">
          <span>Total Amount</span>
          <span class="total-amount" id="summaryTotalAmount">₹<%= (runningSubtotal + (runningSubtotal >= 499 ? 0 : 49)).toLocaleString() %></span>
        </div>

        <div class="checkout-trust-badges">
          <span>🔒 256-bit Secure Checkout</span>
          <span>🎓 Direct Sathyabama Campus Delivery</span>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  // Dynamic Pricing Variables for Client-Side Calculation
  const subtotalVal = <%= runningSubtotal %>;
  let baseShippingVal = <%= runningSubtotal >= 499 ? 0 : 49 %>;
  let appliedDiscountVal = 0;
  const storeUpi = "<%= storeUpiId %>";

  function recalculateTotals() {
    const finalTotal = Math.max(0, subtotalVal + baseShippingVal - appliedDiscountVal);
    
    // Update summary labels
    const totalEl = document.getElementById('summaryTotalAmount');
    if (totalEl) totalEl.textContent = '₹' + finalTotal.toLocaleString();

    // Update UPI card labels
    const upiHeaderTxt = document.getElementById('upiPayAmountTxt');
    if (upiHeaderTxt) upiHeaderTxt.textContent = '₹' + finalTotal.toLocaleString();

    const upiStepTxt = document.getElementById('upiStepAmountTxt');
    if (upiStepTxt) upiStepTxt.textContent = '₹' + finalTotal.toLocaleString();

    // Update Dynamic QR code image URL
    const qrImg = document.getElementById('dynamicUpiQr');
    if (qrImg) {
      const upiUrl = 'upi://pay?pa=' + encodeURIComponent(storeUpi) + '&pn=GOODYGUYS+Studio&am=' + finalTotal + '&cu=INR&tn=GOODYGUYSOrder';
      qrImg.src = 'https://api.qrserver.com/v1/create-qr-code/?size=220x220&data=' + encodeURIComponent(upiUrl);
    }
  }

  // Coupon Handlers
  function fillCoupon(code) {
    const input = document.getElementById('couponInput');
    if (input) {
      input.value = code;
      applyCouponCode();
    }
  }

  function applyCouponCode() {
    const input = document.getElementById('couponInput');
    const feedback = document.getElementById('couponFeedback');
    const hiddenField = document.getElementById('hiddenCouponCode');
    const couponRow = document.getElementById('summaryCouponRow');
    const couponNameEl = document.getElementById('summaryCouponName');
    const deliveryFeeEl = document.getElementById('summaryDeliveryFee');

    if (!input) return;
    const code = input.value.trim().toUpperCase();

    if (!code) {
      feedback.innerHTML = '<div class="coupon-alert error">⚠️ Please enter a coupon code.</div>';
      return;
    }

    if (code === 'SATHYABAMA') {
      appliedDiscountVal = baseShippingVal; // Removes full delivery fee
      if (hiddenField) hiddenField.value = 'SATHYABAMA';

      feedback.innerHTML = `
        <div class="coupon-alert success">
          <span>✓ Coupon <strong>SATHYABAMA</strong> applied! Free campus delivery unlocked.</span>
          <button type="button" class="btn-remove-coupon" onclick="removeCouponCode()">Remove</button>
        </div>
      `;

      if (couponRow) couponRow.style.display = 'flex';
      if (couponNameEl) couponNameEl.textContent = 'SATHYABAMA';
      if (deliveryFeeEl) deliveryFeeEl.innerHTML = '<span style="color: #4ade80; font-weight: 700;">FREE (Coupon)</span>';

      recalculateTotals();
    } else {
      feedback.innerHTML = `
        <div class="coupon-alert error">
          <span>⚠️ Invalid coupon code "${code}". Use <strong>SATHYABAMA</strong> for free delivery inside campus.</span>
        </div>
      `;
    }
  }

  function removeCouponCode() {
    appliedDiscountVal = 0;
    const input = document.getElementById('couponInput');
    const feedback = document.getElementById('couponFeedback');
    const hiddenField = document.getElementById('hiddenCouponCode');
    const couponRow = document.getElementById('summaryCouponRow');
    const deliveryFeeEl = document.getElementById('summaryDeliveryFee');

    if (input) input.value = '';
    if (hiddenField) hiddenField.value = '';
    if (feedback) feedback.innerHTML = '';
    if (couponRow) couponRow.style.display = 'none';
    if (deliveryFeeEl) deliveryFeeEl.textContent = baseShippingVal === 0 ? 'FREE' : '₹49';

    recalculateTotals();
  }

  // Sathyabama Exclusive Campus Delivery Location Validation
  function validateDeliveryLocation() {
    const pincodeEl = document.getElementById('pincode');
    const cityEl = document.getElementById('city');
    const addressEl = document.getElementById('address');
    const bannerEl = document.getElementById('deliveryStatusBanner');
    const submitBtn = document.getElementById('btnPlaceOrder');

    if (!pincodeEl || !bannerEl) return true;

    const pin = pincodeEl.value.trim();
    const city = (cityEl?.value || '').trim().toLowerCase();
    const address = (addressEl?.value || '').trim().toLowerCase();

    // Sathyabama College, Jeppiaar Nagar, OMR Chennai pincode: 600119
    const isCampusPincode = pin === '600119';
    const hasSathyabamaKeywords = address.includes('sathyabama') || address.includes('sist') || address.includes('jeppiaar') || city.includes('sathyabama');

    // If pincode is 6 digits but not 600119
    if (pin.length === 6 && !isCampusPincode) {
      bannerEl.className = 'delivery-status-banner blocked';
      bannerEl.innerHTML = `🚫 <strong>Delivery Not Available for Pincode ${pin}</strong><br>We currently deliver <strong>exclusively inside Sathyabama Institute of Science and Technology campus, Chennai (Pincode: 600119)</strong>. Delivery to outside areas is temporarily unavailable.`;
      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.style.opacity = '0.5';
        submitBtn.style.cursor = 'not-allowed';
      }
      return false;
    }

    // If city is specified and not Chennai or Sathyabama
    if (city && !city.includes('chennai') && !hasSathyabamaKeywords) {
      bannerEl.className = 'delivery-status-banner blocked';
      bannerEl.innerHTML = `🚫 <strong>Delivery Restricted to Sathyabama Campus, Chennai</strong><br>Currently, orders are only delivered within the Sathyabama University campus, Chennai - 600119.`;
      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.style.opacity = '0.5';
        submitBtn.style.cursor = 'not-allowed';
      }
      return false;
    }

    // Eligible
    bannerEl.className = 'delivery-status-banner eligible';
    bannerEl.innerHTML = `✓ <strong>Delivery Available</strong>: Sathyabama College Campus, Chennai (Pincode: 600119).`;
    if (submitBtn) {
      submitBtn.disabled = false;
      submitBtn.style.opacity = '1';
      submitBtn.style.cursor = 'pointer';
    }
    return true;
  }

  function togglePaymentMode(mode) {
    const upiBox = document.getElementById('upiPaymentBox');
    const upiOption = document.getElementById('payOptionUpi');
    const codOption = document.getElementById('payOptionCod');
    const utrInput = document.getElementById('upiTransactionId');

    if (mode === 'UPI') {
      if (upiBox) upiBox.style.display = 'block';
      if (upiOption) upiOption.classList.add('active');
      if (codOption) codOption.classList.remove('active');
      if (utrInput) utrInput.required = true;
    } else {
      if (upiBox) upiBox.style.display = 'none';
      if (upiOption) upiOption.classList.remove('active');
      if (codOption) codOption.classList.add('active');
      if (utrInput) utrInput.required = false;
    }
  }

  function copyUpiId() {
    const upiText = document.getElementById('merchantUpiId').textContent;
    navigator.clipboard.writeText(upiText).then(() => {
      const msg = document.getElementById('copySuccessMsg');
      if (msg) {
        msg.style.display = 'inline';
        setTimeout(() => { msg.style.display = 'none'; }, 2500);
      }
    });
  }

  // Validate form submission
  const checkoutForm = document.getElementById('checkoutOrderForm');
  if (checkoutForm) {
    checkoutForm.addEventListener('submit', function(e) {
      // 1. Check delivery location
      if (!validateDeliveryLocation()) {
        e.preventDefault();
        alert('🚫 Delivery is currently available exclusively within Sathyabama College Campus, Chennai (Pincode: 600119). Please provide an address inside the campus.');
        document.getElementById('pincode')?.focus();
        return false;
      }

      // 2. Check UPI UTR
      const isUpi = document.querySelector('input[name="paymentMethod"]:checked')?.value.includes('UPI');
      if (isUpi) {
        const utr = document.getElementById('upiTransactionId').value.trim();
        if (!utr || utr.length < 6) {
          e.preventDefault();
          alert('⚠️ Please enter your 12-digit UPI Transaction / UTR Number from your GPay/PhonePe payment receipt so we can verify and approve your order!');
          document.getElementById('upiTransactionId').focus();
          return false;
        }
      }
    });
  }

  // Initialize delivery check on page load
  document.addEventListener('DOMContentLoaded', validateDeliveryLocation);
</script>

<%- include('partials/footer') %>
