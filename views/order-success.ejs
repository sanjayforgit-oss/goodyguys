<%- include('partials/header') %>

<section class="success-page">
  <div class="container">
    <div class="success-card">
      <div class="success-icon">🎉</div>
      <span class="success-pill">Order Received by Workshop</span>
      <h1>Thank You, <%= order.customer.name %>!</h1>
      <p class="success-subtitle">Your custom order has been received. Our studio team is preparing the artwork for printing and laser cutting.</p>

      <!-- Order Tracking Timeline -->
      <div class="order-timeline-box">
        <div class="timeline-step done">
          <div class="step-circle">✓</div>
          <span>Order Confirmed</span>
        </div>
        <div class="timeline-line active"></div>
        <div class="timeline-step active">
          <div class="step-circle">⚡</div>
          <span>Laser &amp; Print Queue</span>
        </div>
        <div class="timeline-line"></div>
        <div class="timeline-step">
          <div class="step-circle">🔍</div>
          <span>Quality Check</span>
        </div>
        <div class="timeline-line"></div>
        <div class="timeline-step">
          <div class="step-circle">📦</div>
          <span>Doorstep Delivery</span>
        </div>
      </div>

      <!-- Order Receipt Details -->
      <div class="order-details-card">
        <div class="order-detail-row">
          <span>Order Reference ID</span>
          <span class="order-id">#<%= order.id %></span>
        </div>
        <div class="order-detail-row">
          <span>Date Placed</span>
          <span><%= order.date %></span>
        </div>
        <div class="order-detail-row">
          <span>Delivery Address</span>
          <span><%= order.customer.address %>, <%= order.customer.city %> - <%= order.customer.pincode %></span>
        </div>
        <div class="order-detail-row">
          <span>Contact WhatsApp / Phone</span>
          <span><%= order.customer.phone %></span>
        </div>
        <div class="order-detail-row">
          <span>Payment Mode</span>
          <span><%= order.paymentMethod %></span>
        </div>
        <% if (order.upiTransactionId) { %>
          <div class="order-detail-row" style="background: rgba(34, 197, 94, 0.1); padding: 8px 12px; border-radius: 8px;">
            <span>UPI Transaction / UTR Ref</span>
            <strong style="color: #22c55e;"><%= order.upiTransactionId %></strong>
          </div>
          <div class="order-detail-row">
            <span>Payment Verification</span>
            <span style="color: #fef08a; font-weight: 700;">⏳ Verification Pending (Checking Bank Credit)</span>
          </div>
        <% } %>
        <div class="order-detail-row highlight-total">
          <span>Total Paid / Payable</span>
          <span class="order-total-price">₹<%= order.total.toLocaleString() %></span>
        </div>
      </div>

      <!-- Customized Items Ordered -->
      <div class="ordered-items-summary">
        <h3>Customized Items (<%= order.items.length %>)</h3>
        <div class="success-items-list">
          <% order.items.forEach(item => { %>
            <div class="success-item-card">
              <div class="item-card-left">
                <h4><%= item.productName %></h4>
                <div class="item-specs">
                  <% if (item.customText) { %><span>✍️ Text: <strong><%= item.customText %></strong></span><% } %>
                  <% if (item.placement) { %><span>• Placement: <%= item.placement %></span><% } %>
                  <% if (item.mugSides) { %><span>• Sides: <%= item.mugSides %></span><% } %>
                  <% if (item.material) { %><span>• Acrylic: <%= item.material %></span><% } %>
                  <% if (item.lampBase) { %><span>• Base: <%= item.lampBase %></span><% } %>
                  <% if (item.color) { %><span>• Color: <%= item.color %></span><% } %>
                  <% if (item.size) { %><span>• Size: <%= item.size %></span><% } %>
                  <% if (item.customImageName) { %><span>• Graphic: <%= item.customImageName %></span><% } %>
                </div>
              </div>
              <div class="item-card-right">
                <span class="item-card-qty">Qty: <%= item.quantity %></span>
                <span class="item-card-price">₹<%= (item.unitPrice * item.quantity).toLocaleString() %></span>
              </div>
            </div>
          <% }) %>
        </div>
      </div>

      <div class="success-actions">
        <a href="/" class="btn btn-primary btn-lg">Back to Home</a>
        <a href="/products" class="btn btn-outline btn-lg">Browse More Products</a>
        <a href="/suggest" class="btn btn-ghost">Have an Idea? Suggest a Product →</a>
      </div>
    </div>
  </div>
</section>

<%- include('partials/footer') %>
