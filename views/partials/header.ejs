<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' && title ? title : 'GOODYGUYS — Crafted for the Creators | Custom Streetwear & Precision Laser Studio' %></title>
  <meta name="description" content="<%= typeof description !== 'undefined' && description ? description : 'GOODYGUYS Studio: Premium custom streetwear t-shirts, personalized photo drinkware, and precision laser-cut and engraved optical acrylic merchandise hand-crafted on demand with zero minimum orders.' %>">
  <link rel="canonical" href="<%= typeof canonical !== 'undefined' && canonical ? canonical : 'https://goodyguys-custom.netlify.app' %>">

  <!-- Open Graph / Meta -->
  <meta property="og:type" content="website">
  <meta property="og:url" content="https://goodyguys-custom.netlify.app/">
  <meta property="og:title" content="<%= typeof title !== 'undefined' && title ? title : 'GOODYGUYS — Crafted for the Creators' %>">
  <meta property="og:description" content="Custom streetwear t-shirts, personalized mugs, gaming mousepads, and precision laser-cut optical acrylic keychains. No minimum orders.">
  <meta property="og:image" content="https://goodyguys-custom.netlify.app/images/hero-streetwear-model.jpg">

  <!-- Twitter Meta -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="<%= typeof title !== 'undefined' && title ? title : 'GOODYGUYS — Crafted for the Creators' %>">
  <meta name="twitter:description" content="Custom streetwear t-shirts, personalized mugs, gaming mousepads, and precision laser-cut optical acrylic keychains.">
  <meta name="twitter:image" content="https://goodyguys-custom.netlify.app/images/hero-streetwear-model.jpg">

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Courier+Prime:wght@400;700&family=Dancing+Script:wght@600;700&family=Inter:wght@300;400;500;600;700;800;900&family=Pacifico&family=Permanent+Marker&family=Playfair+Display:ital,wght@0,600;1,600&family=Space+Grotesk:wght@500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
  <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js"></script>
</head>
<body class="streetwear-theme">
  <!-- Accessibility: Skip to Main Content Link -->
  <a href="#mainContent" class="skip-to-content sr-only">Skip to main content</a>

  <!-- Top Ticker Marquee Announcement Bar -->
  <div class="top-marquee-bar" role="region" aria-label="Announcement Ticker">
    <div class="marquee-track">
      <div class="marquee-content">
        <span>⚡ GOODYGUYS STUDIO &bull; LIMITED DROPS &bull; EXCLUSIVE CUSTOM APPAREL</span>
        <span class="dot">&bull;</span>
        <span>NO MINIMUM ORDERS</span>
        <span class="dot">&bull;</span>
        <span>PRECISION LASER CUT-THROUGH ACRYLIC &bull; 0.05MM ACCURACY</span>
        <span class="dot">&bull;</span>
        <span>WEAR YOUR IDEA &bull; PRINTED ON DEMAND</span>
        <span class="dot">&bull;</span>
        <span>FAST DISPATCH ACROSS INDIA</span>
        <span class="dot">&bull;</span>
        <span>100% QUALITY GUARANTEED</span>
        <span class="dot">&bull;</span>
        <span>💡 HAVE AN IDEA? CUSTOMIZE NOW</span>
        <span class="dot">&bull;</span>
      </div>
      <div class="marquee-content" aria-hidden="true">
        <span>⚡ GOODYGUYS STUDIO &bull; LIMITED DROPS &bull; EXCLUSIVE CUSTOM APPAREL</span>
        <span class="dot">&bull;</span>
        <span>NO MINIMUM ORDERS</span>
        <span class="dot">&bull;</span>
        <span>PRECISION LASER CUT-THROUGH ACRYLIC &bull; 0.05MM ACCURACY</span>
        <span class="dot">&bull;</span>
        <span>WEAR YOUR IDEA &bull; PRINTED ON DEMAND</span>
        <span class="dot">&bull;</span>
        <span>FAST DISPATCH ACROSS INDIA</span>
        <span class="dot">&bull;</span>
        <span>100% QUALITY GUARANTEED</span>
        <span class="dot">&bull;</span>
        <span>💡 HAVE AN IDEA? CUSTOMIZE NOW</span>
        <span class="dot">&bull;</span>
      </div>
    </div>
  </div>

  <header class="header" id="header">
    <div class="container header-container">
      <div class="header-inner">
        <!-- Streetwear Logo with GOODYGUYS Branding -->
        <a href="/" class="logo streetwear-logo">
          <div class="logo-badge-icon">
            <svg class="logo-crown-svg" viewBox="0 0 40 28" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M4 24L7 8L16 16L20 4L24 16L33 8L36 24H4Z" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
              <circle cx="4" cy="8" r="2" fill="currentColor"/>
              <circle cx="20" cy="4" r="2" fill="currentColor"/>
              <circle cx="36" cy="8" r="2" fill="currentColor"/>
            </svg>
          </div>
          <div class="logo-text-group">
            <span class="logo-brand">GOODY<span class="brand-volt">GUYS</span></span>
            <span class="logo-tagline">CUSTOM APPAREL &amp; LASER STUDIO</span>
          </div>
        </a>

        <!-- Main Navigation Links -->
        <nav class="nav" id="nav" aria-label="Main Navigation">
          <a href="/" class="nav-link">HOME</a>
          <a href="/products" class="nav-link">THE DROP</a>
          <a href="/suggest" class="nav-link nav-highlight">
            <span>💡 SUGGEST IDEA</span>
            <span class="nav-tag-badge">NEW</span>
          </a>
        </nav>

        <!-- Header Actions: Search, Cart -->
        <div class="header-actions">
          <form class="header-search-form" method="GET" action="/products" role="search">
            <button type="submit" class="search-submit-icon" aria-label="Search products">🔍</button>
            <input type="text" name="search" placeholder="Search apparel, mugs, acrylics..." value="<%= typeof search !== 'undefined' ? search : '' %>" aria-label="Search catalog">
          </form>

          <a href="/cart" class="cart-link streetwear-cart" title="Shopping Cart" aria-label="Shopping Cart">
            <svg class="cart-bag-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
              <line x1="3" y1="6" x2="21" y2="6"></line>
              <path d="M16 10a4 4 0 0 1-8 0"></path>
            </svg>
            <span class="cart-badge volt-badge" id="cart-count"><%= typeof cartCount !== 'undefined' ? cartCount : 0 %></span>
          </a>

          <button class="menu-toggle" id="menuToggle" aria-label="Toggle navigation menu" aria-expanded="false">
            <span></span>
            <span></span>
            <span></span>
          </button>
        </div>
      </div>
    </div>
  </header>
  <main class="main" id="mainContent">
