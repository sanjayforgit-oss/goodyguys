<!-- HORIZONTAL MOVING PRODUCT MARQUEE STRIP (Inspired by Reference Image 3: Urban Threads) -->
<section class="products-marquee-strip-section">
  <div class="container">
    <div class="marquee-strip-header">
      <div class="strip-header-left">
        <span class="strip-hot-badge">⚡ INSTANT SHOWCASE</span>
        <h3 class="strip-title">EXPLORE OUR CUSTOM PRODUCT LINEUP</h3>
      </div>
      <span class="strip-marquee-hint">← AUTO-SCROLLING &bull; HOVER TO PAUSE &bull; CLICK TO CUSTOMIZE →</span>
    </div>
  </div>
  
  <div class="product-marquee-viewport">
    <div class="product-marquee-track">
      <% [1, 2].forEach(() => { %>
        <% products.forEach(prod => { %>
          <a href="/products/<%= prod.id %>" class="marquee-product-card" title="Customize <%= prod.name %>">
            <div class="marquee-card-img-wrap">
              <img src="<%= prod.image %>" alt="<%= prod.name %>" loading="lazy">
              <span class="marquee-card-badge <%= prod.id === 5 ? 'badge-cut' : '' %>">
                <%= prod.id === 5 ? '✂️ LASER CUT' : prod.badge ? prod.badge.toUpperCase() : 'CUSTOM' %>
              </span>
            </div>
            <div class="marquee-card-info">
              <span class="marquee-card-cat"><%= prod.category.replace('-', ' ').toUpperCase() %></span>
              <strong class="marquee-prod-name"><%= prod.name.toUpperCase() %></strong>
              <div class="marquee-card-footer">
                <span class="marquee-price">₹<%= prod.price %></span>
                <span class="marquee-cta-pill">CUSTOMIZE &rarr;</span>
              </div>
            </div>
          </a>
        <% }) %>
      <% }) %>
    </div>
  </div>
</section>

<!-- Dropdown Countdown Bar (Urban Threads Inspired) -->
<section class="drop-countdown-bar">
  <div class="container">
    <div class="countdown-bar-inner">
      <div class="countdown-label-group">
        <span class="pulse-indicator"></span>
        <span class="countdown-title">NEXT CUSTOM PRODUCTION BATCH IN:</span>
      </div>
      <div class="countdown-digits-wrap" id="dropCountdown">
        <div class="digit-box"><span class="num" id="days">02</span><span class="lbl">DAYS</span></div>
        <span class="sep">:</span>
        <div class="digit-box"><span class="num" id="hours">14</span><span class="lbl">HOURS</span></div>
        <span class="sep">:</span>
        <div class="digit-box"><span class="num" id="mins">37</span><span class="lbl">MINS</span></div>
        <span class="sep">:</span>
        <div class="digit-box"><span class="num" id="secs">26</span><span class="lbl">SECS</span></div>
      </div>
      <div class="countdown-badge">
        <span>⚡ ORDERS DISPATCHED IN 24H ACROSS INDIA</span>
      </div>
    </div>
  </div>
</section>

<!-- RIPPED TORN PAPER DIVIDER (Dark to Light Paper) -->
