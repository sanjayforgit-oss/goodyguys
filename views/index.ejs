</div>

<!-- "THE DROP" CATALOG SECTION (Clean Cream Paper Background) -->
<section class="the-drop-section" id="the-drop">
  <div class="container">
    <!-- Header of The Drop -->
    <div class="the-drop-header">
      <div class="title-with-highlighter">
        <h2 class="the-drop-title">THE DROP</h2>
        <div class="brush-stroke-underline"></div>
      </div>
      <p class="the-drop-subtitle">Bestselling custom apparel, laser cut acrylics &amp; precision prints. No minimums.</p>
      <a href="/products" class="btn-view-all">VIEW ALL PRODUCTS &rarr;</a>
    </div>

    <!-- Category Filter Bar (Inspired by Streetwear Navs) -->
    <div class="streetwear-filter-bar">
      <button class="filter-pill active" data-category="all">ALL ITEMS (7)</button>
      <button class="filter-pill" data-category="t-shirts">👕 T-SHIRTS</button>
      <button class="filter-pill" data-category="mugs">☕ MUGS</button>
      <button class="filter-pill" data-category="mousepads">🖱️ MOUSE PADS</button>
      <button class="filter-pill" data-category="laser-acrylic">⚡ LASER ACRYLIC</button>
      <button class="filter-pill" data-category="lamps">💡 3D LAMPS</button>
      <button class="filter-pill" data-category="keychains">🔑 KEYCHAINS</button>
    </div>

    <!-- Product Grid with Realistic Commercial Photography -->
    <div class="streetwear-products-grid">
      <% products.forEach(product => { %>
        <div class="streetwear-card" data-category="<%= product.category %>">
          <!-- Top Tag Badge -->
          <div class="card-badge-corner <%= product.id === 5 ? 'badge-cut' : product.badge === 'Bestseller' ? 'badge-best' : product.badge === 'Laser Tech' ? 'badge-tech' : 'badge-new' %>">
            <%= product.id === 5 ? '✂️ LASER CUT-THROUGH' : product.badge ? product.badge.toUpperCase() : 'NEW' %>
          </div>

          <!-- Product Realistic Image -->
          <div class="card-image-wrap">
            <a href="/products/<%= product.id %>">
              <img src="<%= product.image %>" alt="<%= product.name %>" class="card-prod-img" loading="lazy">
            </a>
            <div class="card-custom-overlay-tag">
              <%= product.id === 5 ? '✂️ FREESTANDING CUT-OUT LETTERS (NO ENGRAVING)' : product.customizerType === 'tshirt' ? '👕 CUSTOM FRONT / BACK' : product.requiresText && product.requiresImage ? '📸 PHOTO + ✍️ TEXT' : product.requiresImage ? '📸 CUSTOM IMAGE' : '⚡ CUSTOM NAME' %>
            </div>
          </div>

          <!-- Card Details -->
          <div class="card-body">
            <span class="card-category-tag"><%= product.category.replace('-', ' ').toUpperCase() %></span>
            <h3 class="card-product-title">
              <a href="/products/<%= product.id %>"><%= product.name.toUpperCase() %></a>
            </h3>

            <div class="card-price-row">
              <span class="price-current">₹<%= product.price %></span>
              <% if (product.originalPrice > product.price) { %>
                <span class="price-original">₹<%= product.originalPrice %></span>
              <% } %>
              <% if (product.placementOptions) { %>
                <span class="card-option-note">(Front / Back / Both)</span>
              <% } else if (product.sideOptions) { %>
                <span class="card-option-note">(1 side ₹150 / 3 sides ₹200)</span>
              <% } %>
            </div>

            <p class="card-spec-desc">
              <%= product.description.substring(0, 85) %>...
            </p>

            <!-- Full-width Streetwear Black Button -->
            <a href="/products/<%= product.id %>" class="btn-card-action">
              <span><%= product.customizerType === 'tshirt' ? 'CUSTOMIZE T-SHIRT' : product.id === 5 ? 'CUT MY NAME' : 'CUSTOMIZE NOW' %></span>
              <span class="cart-btn-icon">🛒</span>
            </a>
          </div>
        </div>
      <% }) %>
    </div>
  </div>
</section>

