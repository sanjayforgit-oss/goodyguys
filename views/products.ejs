<%- include('partials/header') %>

<section class="page-header">
  <div class="container">
    <span class="section-label"><%= search ? 'Search Results' : currentCategory === 'all' ? 'Studio Catalog' : currentCategory.replace('-', ' ').toUpperCase() %></span>
    <h1><%= search ? `Results for "${search}"` : currentCategory === 'all' ? 'All Customizable Products' : currentCategory.replace('-', ' ').charAt(0).toUpperCase() + currentCategory.replace('-', ' ').slice(1) %></h1>
    <p><%= products.length %> customizable item(s) found</p>
  </div>
</section>

<section class="section" style="padding-top: 40px;">
  <div class="container">
    <div class="products-layout">
      <!-- Filter Sidebar -->
      <aside class="filters">
        <h3>Categories</h3>
        <ul class="filter-list">
          <li>
            <a href="/products" class="<%= currentCategory === 'all' ? 'active' : '' %>">
              All Products
              <span class="count"><%= allProducts ? allProducts.length : products.length %></span>
            </a>
          </li>
          <li>
            <a href="/products?category=t-shirts" class="<%= currentCategory === 't-shirts' ? 'active' : '' %>">
              👕 T-Shirts (₹300)
            </a>
          </li>
          <li>
            <a href="/products?category=mugs" class="<%= currentCategory === 'mugs' ? 'active' : '' %>">
              ☕ Mugs (From ₹150)
            </a>
          </li>
          <li>
            <a href="/products?category=mousepads" class="<%= currentCategory === 'mousepads' ? 'active' : '' %>">
              🖱️ Mouse Pads (₹150)
            </a>
          </li>
          <li>
            <a href="/products?category=keychains" class="<%= currentCategory === 'keychains' ? 'active' : '' %>">
              🔑 Custom Keychains (₹100)
            </a>
          </li>
          <li>
            <a href="/products?category=desk-plaques-lamps" class="<%= currentCategory === 'desk-plaques-lamps' ? 'active' : '' %>">
              ⚡ Desk Plaques &amp; 3D Lamps (₹250–₹700)
            </a>
          </li>
        </ul>

        <div class="filter-suggestion-cta">
          <span class="cta-emoji">💡</span>
          <h4>Can't find what you need?</h4>
          <p>We laser cut &amp; print custom orders on request!</p>
          <a href="/suggest" class="btn btn-sm btn-outline btn-block">Suggest an Idea →</a>
        </div>
      </aside>

      <!-- Products Grid & Search Toolbar -->
      <div class="products-content">
        <div class="products-toolbar">
          <form class="search-form" method="GET" action="/products">
            <% if (currentCategory !== 'all') { %>
              <input type="hidden" name="category" value="<%= currentCategory %>">
            <% } %>
            <input type="text" name="search" placeholder="Search T-shirts, mugs, laser acrylic, lamp..." value="<%= search %>">
            <button type="submit">🔍 Search</button>
          </form>
          <span class="toolbar-count"><%= products.length %> product(s)</span>
        </div>

        <% if (products.length === 0) { %>
          <div class="empty-state">
            <span class="icon">🔍</span>
            <h2>No products matched your search</h2>
            <p>Try searching for "t-shirt", "mug", "acrylic", "lamp", or clear your filter.</p>
            <div style="margin-top: 16px; display: flex; gap: 10px; justify-content: center;">
              <a href="/products" class="btn btn-primary">Browse All Products</a>
              <a href="/suggest" class="btn btn-outline">Suggest This Item</a>
            </div>
          </div>
        <% } else { %>
          <div class="products-grid">
            <% products.forEach(product => { %>
              <div class="product-card tilt-card">
                <div class="product-image">
                  <img src="<%= product.image %>" alt="<%= product.name %>" loading="lazy">
                  <% if (product.badge) { %>
                    <span class="badge <%= product.badge === 'Bestseller' ? 'badge-hot' : product.badge === 'Laser Tech' ? 'badge-laser' : '' %>"><%= product.badge %></span>
                  <% } %>
                  <div class="custom-badge-pill">
                    <%= product.customizerType === 'tshirt' ? '👕 Image / Slogan' : product.requiresImage && product.requiresText ? '📸 Photo + ✍️ Text' : product.requiresImage ? '📸 Custom Image' : '⚡ Custom Name' %>
                  </div>
                </div>
                <div class="product-info">
                  <span class="product-category"><%= product.category.replace('-', ' ') %></span>
                  <h3><%= product.name %></h3>
                  <p class="product-summary"><%= product.description.substring(0, 75) %>...</p>
                  <div class="product-price">
                    <span class="current">₹<%= product.price.toLocaleString() %></span>
                    <% if (product.originalPrice > product.price) { %>
                      <span class="original">₹<%= product.originalPrice.toLocaleString() %></span>
                    <% } %>
                    <% if (product.id === 1) { %>
                      <span class="price-note">(Both Sides ₹400)</span>
                    <% } else if (product.sideOptions) { %>
                      <span class="price-note">(1-3 sides ₹150–₹200)</span>
                    <% } else if (product.customizerType === 'desk-plaque') { %>
                      <span class="price-note">(Stand Included • ₹250 / ₹400 / ₹700)</span>
                    <% } else if (product.customizerType === 'engraved-lamp') { %>
                      <span class="price-note">(Warm Wood / RGB ₹300–₹350)</span>
                    <% } else if (product.category === 'keychains') { %>
                      <span class="price-note">(Keyring Included • ₹100)</span>
                    <% } %>
                  </div>
                  <a href="/products/<%= product.id %>" class="btn-catalog-action">
                    <span><%- product.customizerType === 'tshirt' ? '🎨 Customize T-Shirt' : '🎨 Customize & Buy' %></span>
                    <span class="arrow-icon">&rarr;</span>
                  </a>
                </div>
              </div>
            <% }) %>
          </div>
        <% } %>
      </div>
    </div>
  </div>
</section>

<%- include('partials/footer') %>
